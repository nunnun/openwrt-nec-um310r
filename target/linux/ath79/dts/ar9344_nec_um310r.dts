#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "ar9344.dtsi"

/ {
	model = "NEC uM310R";
	compatible = "nec,um310r", "qca,ar9344";

	aliases {
		label-mac-device = &eth0;
		led-boot = &led_alm_green;
		led-failsafe = &led_alm_red;
		led-running = &led_alm_green;
		led-upgrade = &led_alm_red;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&jtag_disable_pins>;

		led-ant-green {
			label = "green:ant";
			gpios = <&gpio 0 GPIO_ACTIVE_HIGH>;
		};

		led-ant-red {
			label = "red:ant";
			gpios = <&gpio 1 GPIO_ACTIVE_HIGH>;
		};

		led-com-green {
			label = "green:com";
			gpios = <&gpio 2 GPIO_ACTIVE_HIGH>;
		};

		led-com-red {
			label = "red:com";
			gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
		};

		led-wlan {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		led-lan1 {
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
		};

		led-lan2 {
			function = LED_FUNCTION_LAN;
			function-enumerator = <2>;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
		};

		led_alm_green: led-alm-green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 21 GPIO_ACTIVE_LOW>;
		};

		led_alm_red: led-alm-red {
			function = LED_FUNCTION_ALARM;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio 22 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * External LMC555 watchdog: GPIO14 = feed (WDI), GPIO15 = enable
	 * (active low, left high/disabled by U-Boot). Like the stock
	 * firmware, it is enabled from userspace late in boot, before the
	 * LTE module is powered up.
	 */
	watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
		hw_algo = "toggle";
		hw_margin_ms = <1600>;
		always-running;
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <50>;

		button-reset {
			label = "reset";
			gpios = <&expander 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		/* DIP switch SW2: ON = active */
		switch-dip1 {
			label = "dip1";
			gpios = <&expander 0 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
			linux,input-type = <EV_SW>;
			debounce-interval = <60>;
		};

		switch-dip2 {
			label = "dip2";
			gpios = <&expander 1 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
			linux,input-type = <EV_SW>;
			debounce-interval = <60>;
		};

		switch-dip3 {
			label = "dip3";
			gpios = <&expander 2 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_2>;
			linux,input-type = <EV_SW>;
			debounce-interval = <60>;
		};

		switch-dip4 {
			label = "dip4";
			gpios = <&expander 3 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_3>;
			linux,input-type = <EV_SW>;
			debounce-interval = <60>;
		};
	};

	i2c: i2c {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		#address-cells = <1>;
		#size-cells = <0>;

		rtc@32 {
			compatible = "epson,rx8010";
			reg = <0x32>;
		};

		hwmon@4c {
			compatible = "national,lm75";
			reg = <0x4c>;
		};

		hwmon@4d {
			compatible = "national,lm75";
			reg = <0x4d>;
		};

		expander: gpio@74 {
			compatible = "nxp,pca9539";
			reg = <0x74>;
			gpio-controller;
			#gpio-cells = <2>;

			/* stock "gpioctl" pins 30-37 = 0-7, 40-47 = 8-15 */
			gpio-line-names = "dip-sw1", "dip-sw2", "dip-sw3", "dip-sw4",
					"lte-ready", "lte-power-off", "", "lte-reset",
					"reset-button", "", "", "lte-power-key",
					"board-reset", "", "", "";

			/* P34/P36 are module status outputs: never drive them */
			lte-reset {
				gpio-hog;
				gpios = <7 GPIO_ACTIVE_HIGH>;
				output-low;
				line-name = "lte-reset";
			};

			/* driving this line high resets the whole board */
			board-reset {
				gpio-hog;
				gpios = <12 GPIO_ACTIVE_HIGH>;
				output-low;
				line-name = "board-reset";
			};
		};
	};
};


&ref {
	clock-frequency = <25000000>;
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;

				nvmem-layout {
					compatible = "u-boot,env";
					env-size = <0x10000>;

					macaddr_uboot_ethaddr: ethaddr {
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@50000 {
				label = "devconf";
				reg = <0x050000 0x010000>;
				read-only;
			};

			/*
			 * Stock uses two 0x750000 image slots at 0x60000 and
			 * 0x7c0000, selected by U-Boot env "activeregion".
			 * OpenWrt uses both slots (and the gap) as one
			 * partition and needs "activeregion=1".
			 */
			partition@60000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x060000 0xeb0000>;
			};

			partition@f10000 {
				label = "ip-counter";
				reg = <0xf10000 0x010000>;
				read-only;
			};

			partition@f20000 {
				label = "art";
				reg = <0xf20000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};
				};
			};

			partition@f30000 {
				label = "devconf2";
				reg = <0xf30000 0x010000>;
				read-only;
			};

			partition@f40000 {
				label = "syslog";
				reg = <0xf40000 0x090000>;
				read-only;
			};

			partition@fd0000 {
				label = "lte-log";
				reg = <0xfd0000 0x010000>;
				read-only;
			};

			partition@fe0000 {
				label = "mgmt-config";
				reg = <0xfe0000 0x010000>;
				read-only;
			};
		};
	};
};

&usb {
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&wmac {
	status = "okay";

	nvmem-cells = <&macaddr_uboot_ethaddr 1>, <&cal_art_1000>;
	nvmem-cell-names = "mac-address", "calibration";
};

&eth1 {
	status = "okay";

	nvmem-cells = <&macaddr_uboot_ethaddr 0>;
	nvmem-cell-names = "mac-address";

	gmac-config {
		device = <&gmac>;
		switch-phy-swap = <0>;
		switch-only-mode = <1>;
	};
};

&eth0 {
	status = "okay";

	phy-handle = <&swphy4>;

	nvmem-cells = <&macaddr_uboot_ethaddr 9>;
	nvmem-cell-names = "mac-address";
};

/* the external GPIO watchdog is used instead */
&wdt {
	status = "disabled";
};
