#!/bin/sh
# The um310r packages come from a local feed that exists only in this build;
# drop its (non-existent) downloads.openwrt.org entry so that "apk update"
# does not fail on it. distfeeds.list is regenerated by every sysupgrade and
# uci-defaults run again after it.
sed -i '/\/um310r\/packages\.adb$/d' /etc/apk/repositories.d/distfeeds.list 2>/dev/null
exit 0
